# ─────────────────────────────────────────────────────────────────────────────
# Belessence (Mari Beauty) — variáveis de ambiente (EXEMPLO)
# ─────────────────────────────────────────────────────────────────────────────
# Como usar:
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores reais (NUNCA comite o .env — só este .env.example).
#
# Onde cada valor vive em cada ambiente:
#   • dev      → este .env local (banco = Docker; credenciais externas = sandbox)
#   • preview  → Vercel, escopo "Preview"  (banco = branch Neon "preview")
#   • prod     → Vercel, escopo "Production" (banco = Neon primário; creds LIVE)
#   • CI       → GitHub Actions Secrets (valores dummy/de teste)
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────────────────────
# DEV: aponta para o Postgres do docker-compose (db "belessence_dev", porta 5544).
# PREVIEW/PROD: use a connection string do Neon (com sslmode=require & pooling).
DATABASE_URL="postgresql://belessence:belessence@localhost:5544/belessence_dev?schema=public"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Gere um segredo com:  npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="changeme-gere-um-segredo-aleatorio"
# Em dev/local mantenha "true". A Vercel define o host automaticamente em prod.
AUTH_TRUST_HOST="true"

# ── Admin (login + 2FA) ──────────────────────────────────────────────────────
# Valor do cookie `admin_session` validado no middleware (protege /admin/*).
ADMIN_SECRET="changeme-segredo-do-admin"
# Senha em texto puro usada APENAS pelos scripts de setup (scripts/admin-*.mjs)
# para gerar o hash abaixo. Não é lida pelo app em runtime.
ADMIN_PASSWORD="changeme-senha-do-admin"
# Hash bcrypt da senha admin (gere com: node scripts/admin-set-password.mjs).
ADMIN_PASSWORD_HASH="$2a$..."
# Segredo TOTP do 2FA do admin (gere com: node scripts/admin-setup.mjs).
ADMIN_TOTP_SECRET="changeme-base32-totp"
# E-mails autorizados a logar como admin via Google (separados por vírgula).
ADMIN_ALLOWLIST_EMAILS="voce@exemplo.com"

# ── OAuth Google (login admin) ───────────────────────────────────────────────
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="changeme-google-oauth-secret"

# ── Cloudinary (imagens de produto) ──────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="seu-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="000000000000000"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER="belessence/dev"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="changeme-cloudinary-secret"

# ── Mercado Pago (pagamentos) ────────────────────────────────────────────────
# Lido em src/lib/payment/.../payment-provider.ts.
# dev/preview: use o Access Token de TESTE (sandbox). prod: token LIVE.
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxx-000000000"

# ── Resend (e-mail transacional) ─────────────────────────────────────────────
# AINDA NÃO referenciado no código. Descomente e configure quando o envio de
# e-mail (React Email) for implementado.
# RESEND_API_KEY="re_xxxxxxxx"

# ── Testes E2E (Playwright) — opcional ───────────────────────────────────────
# Padrões já assumidos pelo playwright.config.ts; só sobrescreva se precisar.
# E2E_BASE_URL="http://localhost:3000"
# E2E_PORT="3000"
